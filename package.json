{
  "name": "sietium-ai-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "electron ."
  },
  "dependencies": {
    "axios": "^1.10.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.1.0",
    "highlight.js": "^11.11.1",
    "marked": "^16.0.0",
    "module-alias": "^2.2.3",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.3",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.17",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.17",
    "vue-tsc": "^2.0.26"
  },
  "build": {
    "appId": "com.sietium-ai-studio.app",
    "productName": "Sietium-AI-Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "node_modules"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "main": "dist-electron/main.js"
}
